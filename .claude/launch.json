{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Client (Vite)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["../node_modules/vite/bin/vite.js"],
      "cwd": "client",
      "envFile": ".env.claude",
      "autoPort": false,
      "port": 3001
    },
    {
      "name": "Server (Express)",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": ["run", "dev"],
      "cwd": "server",
      "envFile": ".env.claude",
      "autoPort": false,
      "port": 5001
    }
  ]
}